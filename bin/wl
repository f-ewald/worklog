#!/usr/bin/env ruby
# frozen_string_literal: true

# This is the main entry point for the worklog CLI.

if ENV['WL_PATH']
  # WL_PATH is a development-only override that loads worklog from a local
  # checkout instead of the installed gem. Never set this in production.
  wl_lib = File.expand_path(File.join(ENV['WL_PATH'], 'lib'))
  unless Dir.exist?(wl_lib)
    warn "WL_PATH is set but '#{wl_lib}' does not exist. Ignoring WL_PATH."
    require_relative '../lib/cli'
  else
    warn "Loading worklog from #{ENV['WL_PATH']}. This should only be used during development."
    warn 'To use the installed worklog, unset the WL_PATH environment variable.'
    $LOAD_PATH.unshift wl_lib
    require 'cli'
  end
else
  require_relative '../lib/cli'
end

# Start the Worklog CLI application (Thor application)
WorklogCLI.start
